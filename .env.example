# Web3Forms API Key
# Request a free access key at https://web3forms.com by entering your email (efraimjamestalucod88@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Supabase (public — safe to expose client-side, access is restricted by Row Level Security)
# Find these in your Supabase project under Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key — SERVER-SIDE ONLY (used by api/*.ts functions on Vercel).
# Never prefix this with VITE_ and never commit a real value: it bypasses Row Level Security.
# Set the real value in Vercel project settings, not in a local .env that gets bundled.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

